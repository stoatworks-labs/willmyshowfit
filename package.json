{
  "name": "willmyshowfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Will my show fit? — describe a show's screens, layers, sources and destinations, and see which video switchers it actually fits on, with a proposed wiring topology for each.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "serve:dist": "python3 scripts/serve-dist.py --dir dist --port 4331",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^28.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
